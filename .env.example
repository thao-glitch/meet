# Django Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-with-a-secure-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.example.com
DATABASE_URL=sqlite:///db.sqlite3

# Flask Configuration
FLASK_SECRET_KEY=flask-insecure-secret-key-change-in-production
FLASK_DEBUG=True
FLASK_ENV=development

# Shared Security
FLASK_DJANGO_SECRET=your-shared-secret-key-change-in-production

# URLs
DJANGO_BASE_URL=http://localhost:8000
SOCKET_SERVER_URL=http://localhost:5000

# Ports
DJANGO_PORT=8000
FLASK_PORT=5000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=INFO

# Optional: Production Settings
# DATABASE_ENGINE=postgresql
# DATABASE_HOST=db.example.com
# DATABASE_PORT=5432
# DATABASE_NAME=conference_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=secure_password

# Optional: Redis Configuration
# REDIS_URL=redis://localhost:6379/0

# Optional: AWS S3 (for media storage)
# AWS_STORAGE_BUCKET_NAME=conference-media
# AWS_S3_REGION_NAME=us-east-1
